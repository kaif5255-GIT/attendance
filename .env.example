# ========================================================
# Database Configuration (MySQL)
# ========================================================
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=employee_attendance_db
# Set to 'true' if connecting to a cloud DB that requires SSL (Render / AWS / Aiven)
DB_SSL=false

# ========================================================
# Authentication & Security
# ========================================================
# Generate a strong key in production (e.g., using `openssl rand -hex 32`)
SECRET_KEY=generate_a_secure_random_key_here

# ========================================================
# Initial Administrator Setup (for running seed_admin.py)
# ========================================================
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=AdminPassword123!
